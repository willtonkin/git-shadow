#!/usr/bin/env bash
# shadow: keep personal, untracked files for a repo in a separate local git
# repo under $SHADOW_HOME, and symlink them into every checkout of that repo.
#
# Each shadow repo has a manifest at <shadow>/.shadow:
#   match      <key>              repo identity: normalised origin URL, or path:<git-common-dir>
#   link       <path>             path to symlink into each checkout; trailing / means directory
#   per-branch <path> [numbered]  new files for <path> go in a per-branch area, reached from each
#                                 checkout through .branch-shadow/<path>; `numbered` gives them the
#                                 next NNNN- prefix when the branch is promoted
#   trunk      <branch>           branch whose new files go straight to the accepted paths
#                                 (default: origin/HEAD); it gets no per-branch area
#   context    <file>             file (relative to the shadow repo) printed into agent context at session start
#   autocommit on                 commit the shadow repo when an agent session ends
#
# Per-branch areas live at <shadow>/branches/<slug>/, where <slug> is the branch
# name with / encoded as ~ (git forbids ~ in branch names, so it can't collide).
set -euo pipefail

SHADOW_HOME="${SHADOW_HOME:-$HOME/shadow}"
DECLINED="$SHADOW_HOME/.declined"
BRANCH_LINK=.branch-shadow
BEGIN_MARK='# >>> shadow (managed by `shadow sync`; edit the manifest instead)'
END_MARK='# <<< shadow'

die() { echo "shadow: $*" >&2; exit 1; }
warn() { echo "shadow: $*" >&2; }

usage() {
  cat <<'EOF'
usage: shadow <command>

  init [name]                        create a shadow repo for the current repo and attach this checkout
  sync [--all]                       bring this checkout (or every worktree) in line with the manifest
  status                             show links in this checkout and every branch's per-branch area
  promote <branch> [--into <branch>] move a branch's per-branch files into the accepted files,
                                     or (--into) over to a renamed branch
  drop <branch>                      delete a branch's per-branch files
  decline                            never offer a shadow repo for the current repo
  hook-start                         Claude Code SessionStart hook: sync, then print context
  hook-end                           Claude Code SessionEnd hook: autocommit the shadow repo
EOF
}

repo_key() {
  local url host rest
  url=$(git config --get remote.origin.url 2>/dev/null || true)
  if [ -z "$url" ]; then
    printf 'path:%s\n' "$(git rev-parse --path-format=absolute --git-common-dir)"
    return
  fi
  url=${url%/}; url=${url%.git}
  url=${url#*://}
  url=${url#*@}
  case $url in
    *:*)
      host=${url%%:*}; rest=${url#*:}
      case $host in */*) ;; *)
        rest=$(printf '%s' "$rest" | sed -E 's#^[0-9]+/##')
        url="$host/$rest" ;;
      esac ;;
  esac
  printf '%s\n' "$url"
}

# manifest_values <shadow-dir> <directive>: print the first argument of each line
manifest_values() {
  awk -v k="$2" '$1 == k { print $2 }' "$1/.shadow"
}

# per_branch_paths <shadow-dir>: print "<path> <numbered|->" per per-branch line
per_branch_paths() {
  awk '$1 == "per-branch" { d = $2; sub("/$", "", d); print d, ($3 == "numbered" ? "numbered" : "-") }' "$1/.shadow"
}

# has_per_branch <shadow-dir>: does the manifest declare any per-branch paths?
has_per_branch() { [ -n "$(per_branch_paths "$1")" ]; }

# find_shadow <key>: print the shadow dir whose manifest matches, if any
find_shadow() {
  local m
  for m in "$SHADOW_HOME"/*/.shadow; do
    [ -f "$m" ] || continue
    if [ "$(manifest_values "$(dirname "$m")" match)" = "$1" ]; then
      dirname "$m"
      return 0
    fi
  done
  return 1
}

is_declined() {
  [ -f "$DECLINED" ] && grep -qxF "$1" "$DECLINED"
}

# trunk_branch <shadow-dir>
trunk_branch() {
  local t
  t=$(manifest_values "$1" trunk)
  [ -n "$t" ] || t=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's#^origin/##')
  printf '%s\n' "$t"
}

branch_slug() { printf '%s\n' "${1//\//~}"; }

# branch_area <shadow-dir> <branch>: the branch's branch area (which may not exist yet)
branch_area() { printf '%s/branches/%s\n' "$1" "$(branch_slug "$2")"; }

# branch_areas <shadow-dir>: print every branch area that records its branch
branch_areas() {
  local area
  for area in "$1"/branches/*/; do
    area=${area%/}
    [ -f "$area/.branch" ] && echo "$area"
  done
  return 0
}

branch_exists() { git show-ref --verify --quiet "refs/heads/$1"; }

# is_our_link <path> <target>: is <path> a symlink pointing exactly at <target>?
is_our_link() { [ -L "$1" ] && [ "$(readlink "$1")" = "$2" ]; }

# branch_name <branch-area-dir>: the real branch name recorded in .branch
branch_name() { awk '$1 == "name" { print $2 }' "$1/.branch"; }

# branch_file_count <branch-area-dir>: files other than the .branch marker
branch_file_count() { find "$1" -type f ! -path "$1/.branch" | wc -l | tr -d ' '; }

# write_exclude <git-common-dir> <shadow-dir>: replace the managed block
write_exclude() {
  local exclude="$1/info/exclude" tmp p
  mkdir -p "$1/info"
  touch "$exclude"
  tmp=$(mktemp "$exclude.XXXXXX")
  awk -v b="$BEGIN_MARK" -v e="$END_MARK" '
    $0 == b { skip = 1; next }
    $0 == e { skip = 0; next }
    !skip
  ' "$exclude" > "$tmp"
  {
    echo "$BEGIN_MARK"
    manifest_values "$2" link | while read -r p; do echo "/${p%/}"; done
    has_per_branch "$2" && echo "/$BRANCH_LINK"
    echo "$END_MARK"
  } >> "$tmp"
  mv "$tmp" "$exclude"
}

# sync_branch_link <checkout-top> <shadow-dir>: point .branch-shadow at this branch's area
sync_branch_link() {
  local top=$1 shadow=$2 dst="$1/$BRANCH_LINK" branch area p
  if [ -e "$dst" ] && [ ! -L "$dst" ]; then
    warn "skipped $BRANCH_LINK: a real file is in the way"
    return
  fi
  # Only ever replace a link we made.
  if [ -L "$dst" ]; then
    case $(readlink "$dst") in
      "$shadow/branches/"*) rm "$dst" ;;
      *) warn "skipped $BRANCH_LINK: already a symlink to $(readlink "$dst")"; return ;;
    esac
  fi
  has_per_branch "$shadow" || return 0
  branch=$(git -C "$top" symbolic-ref --quiet --short HEAD) || return 0
  [ "$branch" = "$(cd "$top" && trunk_branch "$shadow")" ] && return 0
  area=$(branch_area "$shadow" "$branch")
  mkdir -p "$area"
  [ -f "$area/.branch" ] || printf 'name    %s\ncreated %s\n' "$branch" "$(date +%F)" > "$area/.branch"
  while read -r p _; do mkdir -p "$area/$p"; done < <(per_branch_paths "$shadow")
  ln -s "$area" "$dst"
}

# sync_checkout <checkout-top> <shadow-dir>
sync_checkout() {
  local top=$1 shadow=$2 common state p name src dst old
  common=$(git -C "$top" rev-parse --path-format=absolute --git-common-dir)
  state="$(git -C "$top" rev-parse --path-format=absolute --git-dir)/shadow-links"

  # Prune links this checkout made for paths no longer in the manifest.
  if [ -f "$state" ]; then
    while read -r old; do
      manifest_values "$shadow" link | sed 's#/$##' | grep -qxF "$old" && continue
      dst="$top/$old"
      if is_our_link "$dst" "$shadow/$old"; then
        rm "$dst"
        # Remove parent dirs the link left empty, so a manifest can switch
        # from linking files to linking their directory.
        dst=$(dirname "$dst")
        while [ "$dst" != "$top" ] && rmdir "$dst" 2>/dev/null; do
          dst=$(dirname "$dst")
        done
      fi
    done < "$state"
  fi

  : > "$state.new"
  while read -r p; do
    name=${p%/}
    src="$shadow/$name"
    dst="$top/$name"
    if [ -L "$dst" ]; then
      if is_our_link "$dst" "$src"; then
        echo "$name" >> "$state.new"
      else
        warn "skipped $name: already a symlink to $(readlink "$dst")"
      fi
      continue
    fi
    if [ -e "$dst" ]; then
      if git -C "$top" ls-files --error-unmatch -- "$name" >/dev/null 2>&1; then
        warn "skipped $name: tracked in this checkout"
        continue
      fi
      if [ -e "$src" ] || [ -L "$src" ]; then
        warn "skipped $name: untracked copy here and in the shadow repo; merge by hand"
        continue
      fi
      mkdir -p "$(dirname "$src")"
      mv "$dst" "$src"
      warn "adopted $name into $shadow"
    fi
    case $p in */) mkdir -p "$src" ;; esac
    mkdir -p "$(dirname "$dst")"
    ln -s "$src" "$dst"
    echo "$name" >> "$state.new"
  done < <(manifest_values "$shadow" link)
  mv "$state.new" "$state"

  sync_branch_link "$top" "$shadow"
  write_exclude "$common" "$shadow"
}

# gone_branch_areas <shadow-dir>: print branch areas whose branch no longer exists
gone_branch_areas() {
  local area
  while read -r area; do
    branch_exists "$(branch_name "$area")" || echo "$area"
  done < <(branch_areas "$1")
}

# prune_empty_gone_branch_areas <shadow-dir>: remove gone branch areas with no proposals.
# Best effort: a failed removal never stops the caller.
prune_empty_gone_branch_areas() {
  local area
  while read -r area; do
    if [ "$(branch_file_count "$area")" = 0 ]; then rm -rf "$area" || true; fi
  done < <(gone_branch_areas "$1")
}

# require_shadow: print the current repo's shadow dir, or die. Assign it on its own
# line (`shadow=$(require_shadow)`): `local shadow=$(...)` would hide the failure.
require_shadow() {
  git rev-parse --show-toplevel >/dev/null 2>&1 || die "not inside a git checkout"
  find_shadow "$(repo_key)" || die "no shadow repo for $(repo_key); run \`shadow init\`"
}

# commit_shadow <shadow-dir> <message>: commit everything, if autocommit is on
commit_shadow() {
  [ "$(manifest_values "$1" autocommit)" = on ] || return 0
  [ -n "$(git -C "$1" status --porcelain)" ] || return 0
  git -C "$1" add -A
  git -C "$1" commit -q -m "$2"
}

cmd_init() {
  git rev-parse --show-toplevel >/dev/null 2>&1 || die "not inside a git checkout"
  local key name shadow
  key=$(repo_key)
  if shadow=$(find_shadow "$key"); then die "$key already has a shadow repo: $shadow"; fi
  name=${1:-$(basename "$key")}
  shadow="$SHADOW_HOME/$name"
  [ -e "$shadow" ] && die "$shadow already exists; pass a different name"
  mkdir -p "$shadow"
  cat > "$shadow/.shadow" <<EOF
match   $key
# link       <path>             symlinked into every checkout; trailing / for a directory
# per-branch <path> [numbered]  new files for <path> go in .branch-shadow/<path>, one area per branch
# context    <file>             printed into agent context at session start
# autocommit on                 commit this repo when an agent session ends
EOF
  git -C "$shadow" init -q
  if [ -f "$DECLINED" ]; then
    grep -vxF "$key" "$DECLINED" > "$DECLINED.tmp" || true
    mv "$DECLINED.tmp" "$DECLINED"
  fi
  sync_checkout "$(git rev-parse --show-toplevel)" "$shadow"
  echo "created $shadow; add link lines to $shadow/.shadow, then run \`shadow sync --all\`"
}

cmd_sync() {
  local shadow
  shadow=$(require_shadow)
  if [ "${1:-}" = "--all" ]; then
    local wt
    git worktree list --porcelain | sed -n 's/^worktree //p' | while read -r wt; do
      [ -d "$wt" ] || continue
      sync_checkout "$wt" "$shadow" 2>&1 | sed "s#^#$wt: #" >&2
    done
  else
    sync_checkout "$(git rev-parse --show-toplevel)" "$shadow"
  fi
}

cmd_status() {
  local shadow top p name state area branch
  shadow=$(require_shadow)
  top=$(git rev-parse --show-toplevel)
  echo "repo:   $(repo_key)"
  echo "shadow: $shadow"
  while read -r p; do
    name=${p%/}
    if is_our_link "$top/$name" "$shadow/$name"; then
      state=linked
    elif [ -e "$top/$name" ]; then
      state="conflict (real file)"
    else
      state=missing
    fi
    printf '  %-40s %s\n' "$name" "$state"
  done < <(manifest_values "$shadow" link)
  has_per_branch "$shadow" || return 0
  if [ -L "$top/$BRANCH_LINK" ]; then
    printf '  %-40s -> %s\n' "$BRANCH_LINK" "$(readlink "$top/$BRANCH_LINK")"
  else
    printf '  %-40s %s\n' "$BRANCH_LINK" "not linked (detached HEAD?)"
  fi
  echo "per-branch areas:"
  branch=$(git symbolic-ref --quiet --short HEAD || true)
  while read -r area; do
    name=$(branch_name "$area")
    if [ "$name" = "$(trunk_branch "$shadow")" ]; then state=trunk
    elif [ "$name" = "$branch" ]; then state=current
    elif branch_exists "$name"; then state=exists
    else state=gone
    fi
    printf '  %-50s %-8s %s files\n' "$name" "$state" "$(branch_file_count "$area")"
  done < <(branch_areas "$shadow")
}

# promote_into_branch <shadow-dir> <branch> <new-branch>: move a branch area to a renamed branch
promote_into_branch() {
  local shadow=$1 name=$2 into=$3 src dst
  src=$(branch_area "$shadow" "$name")
  dst=$(branch_area "$shadow" "$into")
  [ -e "$dst" ] && die "$into already has per-branch files; merge them by hand"
  mv "$src" "$dst"
  sed -i '' "s#^name .*#name    $into#" "$dst/.branch"
  commit_shadow "$shadow" "chore: move per-branch files from $name to $into"
  echo "moved per-branch files from $name to $into; run \`shadow sync --all\` to repoint checkouts"
}

# promote_to_accepted <shadow-dir> <branch>: move a branch area's proposals to their accepted paths
promote_to_accepted() {
  local shadow=$1 name=$2 src plan rel target dir numbered n base old_name new_name f
  src=$(branch_area "$shadow" "$name")

  # Plan every move first (relative source -> relative target), so a clash
  # aborts before anything is touched.
  plan=$(mktemp)
  trap "rm -f '$plan'" EXIT
  while read -r rel; do
    target=$rel
    while read -r dir numbered; do
      case $rel in "$dir"/*) ;; *) continue ;; esac
      base=${rel#"$dir"/}
      if [ "$numbered" = numbered ] && [[ $base != */* ]] && ! [[ $base =~ ^[0-9]{4}- ]]; then
        n=$( { ls "$shadow/$dir" 2>/dev/null; awk -F'\t' '{ print $2 }' "$plan" | sed -n "s#^$dir/##p"; } \
          | grep -oE '^[0-9]{4}' | sort -n | tail -1 || true)
        target="$dir/$(printf '%04d' $((10#${n:-0} + 1)))-$base"
      fi
    done < <(per_branch_paths "$shadow")
    [ -e "$shadow/$target" ] && die "promoting $rel would overwrite $target; resolve by hand"
    printf '%s\t%s\n' "$rel" "$target" >> "$plan"
  done < <(cd "$src" && find . -type f ! -path ./.branch | sed 's#^\./##' | sort)

  while IFS=$'\t' read -r rel target; do
    mkdir -p "$(dirname "$shadow/$target")"
    mv "$src/$rel" "$shadow/$target"
  done < "$plan"

  # Renumbering renames files; fix references between the promoted files.
  while IFS=$'\t' read -r rel target; do
    old_name=$(basename "$rel") new_name=$(basename "$target")
    [ "$old_name" = "$new_name" ] && continue
    awk -F'\t' '{ print $2 }' "$plan" | while read -r f; do
      OLD_NAME=$old_name NEW_NAME=$new_name perl -pi -e 's/\Q$ENV{OLD_NAME}\E/$ENV{NEW_NAME}/g' "$shadow/$f"
    done
  done < "$plan"

  rm -rf "$src"
  commit_shadow "$shadow" "chore: promote per-branch files from $name"
  awk -F'\t' '{ print "promoted " $1 " -> " $2 }' "$plan"
}

cmd_promote() {
  local shadow name=${1:-} into=""
  shadow=$(require_shadow)
  [ -n "$name" ] || die "usage: shadow promote <branch> [--into <branch>]"
  if [ "${2:-}" = --into ]; then
    into=${3:-}
    [ -n "$into" ] || die "usage: shadow promote <branch> --into <branch>"
  fi
  [ -d "$(branch_area "$shadow" "$name")" ] || die "no per-branch files for $name"
  if [ -n "$into" ]; then
    promote_into_branch "$shadow" "$name" "$into"
  else
    promote_to_accepted "$shadow" "$name"
  fi
}

cmd_drop() {
  local shadow name=${1:-} src
  shadow=$(require_shadow)
  [ -n "$name" ] || die "usage: shadow drop <branch>"
  src=$(branch_area "$shadow" "$name")
  [ -d "$src" ] || die "no per-branch files for $name"
  rm -rf "$src"
  commit_shadow "$shadow" "chore: drop per-branch files from $name"
  echo "dropped per-branch files from $name (recoverable from the shadow repo's git history)"
}

cmd_decline() {
  git rev-parse --show-toplevel >/dev/null 2>&1 || die "not inside a git checkout"
  mkdir -p "$SHADOW_HOME"
  repo_key >> "$DECLINED"
  echo "won't offer a shadow repo for $(repo_key) again"
}

cmd_hook_start() {
  cat > /dev/null || true
  git rev-parse --show-toplevel >/dev/null 2>&1 || exit 0
  local key shadow f out top branch p numbered gone area bin
  bin=$(command -v shadow 2>/dev/null || echo "$0")
  key=$(repo_key)
  if ! shadow=$(find_shadow "$key"); then
    is_declined "$key" && exit 0
    cat <<EOF
shadow: this repo ($key) has no shadow repo for personal, untracked files.
At a natural pause, ask the user once whether to create one (\`$bin init\`)
or never be asked again for this repo (\`$bin decline\`). Don't run either without their answer.
EOF
    exit 0
  fi

  top=$(git rev-parse --show-toplevel)
  out=$(sync_checkout "$top" "$shadow" 2>&1) || true
  [ -n "$out" ] && printf '%s\n\n' "$out"

  while read -r f; do
    [ -f "$shadow/$f" ] || continue
    printf '<!-- %s, from shadow repo %s -->\n' "$f" "$shadow"
    cat "$shadow/$f"
    echo
  done < <(manifest_values "$shadow" context)

  if has_per_branch "$shadow"; then
    branch=$(git symbolic-ref --quiet --short HEAD || true)
    if [ -n "$branch" ] && [ "$branch" = "$(trunk_branch "$shadow")" ]; then
      echo "shadow: this checkout is on the trunk branch ($branch), so new files go straight in the accepted paths."
    elif [ -n "$branch" ]; then
      echo "shadow: this checkout is on branch $branch. Existing files stay where they are and are"
      echo "edited in place, but put NEW files for these paths in this branch's area instead:"
      while read -r p numbered; do
        printf '  %s/ -> %s/%s/' "$p" "$BRANCH_LINK" "$p"
        [ "$numbered" = numbered ] && printf '  (no NNNN- prefix; numbers are assigned on promote)'
        echo
      done < <(per_branch_paths "$shadow")
      echo "Read both locations: $BRANCH_LINK/ holds this branch's proposals, the plain paths hold accepted files."
    else
      echo "shadow: this checkout has no branch (detached HEAD), so it has no per-branch area."
      echo "Before creating a new file under $(per_branch_paths "$shadow" | awk '{ printf "%s%s/", sep, $1; sep = ", " }'), ask the user where it should go."
    fi
    echo

    prune_empty_gone_branch_areas "$shadow"
    gone=$(gone_branch_areas "$shadow")
    if [ -n "$gone" ]; then
      echo "shadow: these branches no longer exist, but still have per-branch files:"
      while read -r area; do
        echo "  $(branch_name "$area") ($(branch_file_count "$area") files)"
      done <<< "$gone"
      echo "At a natural pause, ask the user what to do with each: promote into the accepted files"
      echo "(\`$bin promote <branch>\`), move to a renamed branch (\`$bin promote <branch> --into <new>\`),"
      echo "or drop (\`$bin drop <branch>\`). Don't run any of these without their answer."
    fi
  fi
  exit 0
}

cmd_hook_end() {
  cat > /dev/null || true
  git rev-parse --show-toplevel >/dev/null 2>&1 || exit 0
  local shadow branch
  shadow=$(find_shadow "$(repo_key)") || exit 0
  branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo detached)
  commit_shadow "$shadow" "chore: sync from $branch ($(basename "$(git rev-parse --show-toplevel)"))" || true
  exit 0
}

case "${1:-}" in
  init) shift; cmd_init "$@" ;;
  sync) shift; cmd_sync "$@" ;;
  status) cmd_status ;;
  promote) shift; cmd_promote "$@" ;;
  drop) shift; cmd_drop "$@" ;;
  decline) cmd_decline ;;
  hook-start) cmd_hook_start ;;
  hook-end) cmd_hook_end 2>/dev/null ;;
  -h|--help|help|"") usage ;;
  *) usage >&2; exit 2 ;;
esac
