#!/usr/bin/env bash
# git-shadow: keep personal, untracked files for a repo in a separate local git
# repo under $SHADOW_HOME, and symlink them into every checkout of that repo.
#
# Each shadow repo has a manifest at <shadow>/.shadow:
#   match      <key>              repo identity: normalised origin URL, or path:<git-common-dir>
#   link       <path>             path to symlink into each checkout; trailing / means directory
#   per-branch <path> [numbered]  new files for <path> go in a per-branch area, reached from each
#                                 checkout through .branch-shadow/<path>; `numbered` gives them the
#                                 next NNNN- prefix when the branch is promoted
#   trunk      <branch>           branch whose new files go straight to the accepted paths; it
#                                 gets no branch area. `init` writes it; with none, branch
#                                 areas are off
#   context    <file>             file (relative to the shadow repo) printed into agent context at session start
#   autocommit on                 commit the shadow repo when an agent session ends
#
# Per-branch areas live at <shadow>/branches/<slug>/, where <slug> is the branch
# name with / encoded as ~ (git forbids ~ in branch names, so it can't collide).
set -euo pipefail

SHADOW_HOME="${SHADOW_HOME:-$HOME/shadow}"
DECLINED="$SHADOW_HOME/.declined"
BRANCH_LINK=.branch-shadow
# shellcheck disable=SC2016  # the backticks are literal text
BEGIN_MARK='# >>> shadow (managed by `shadow sync`; edit the manifest instead)'
END_MARK='# <<< shadow'

die() { echo "git-shadow: $*" >&2; exit 1; }
warn() { echo "git-shadow: $*" >&2; }

usage() {
  cat <<'EOF'
usage: git shadow <command>   (or git-shadow <command>)

  init [name] [--link <path>]...     create a shadow repo for the current repo and attach this checkout,
                                     linking each <path> and adopting the files already there
  sync [--all]                       bring this checkout (or every worktree) in line with the manifest
  status                             show links in this checkout and every branch's per-branch area
  onboard                            print this repo's state and a prompt that has an agent move your
                                     personal files into a shadow repo; paste it to your agent, or let
                                     the agent run it
  promote <branch> [--into <branch>] move a branch's per-branch files into the accepted files,
                                     or (--into) over to a renamed branch
  drop <branch>                      delete a branch's per-branch files
  decline                            never offer a shadow repo for the current repo
  hook-start                         Claude Code SessionStart hook: sync, then print context
  hook-end                           Claude Code SessionEnd hook: autocommit the shadow repo
EOF
}

repo_key() {
  local url host rest
  url=$(git config --get remote.origin.url 2>/dev/null || true)
  if [ -z "$url" ]; then
    printf 'path:%s\n' "$(git rev-parse --path-format=absolute --git-common-dir)"
    return
  fi
  url=${url%/}; url=${url%.git}
  url=${url#*://}
  url=${url#*@}
  case $url in
    *:*)
      host=${url%%:*}; rest=${url#*:}
      case $host in */*) ;; *)
        rest=$(printf '%s' "$rest" | sed -E 's#^[0-9]+/##')
        url="$host/$rest" ;;
      esac ;;
  esac
  printf '%s\n' "$url"
}

# manifest_values <shadow-dir> <directive>: print the first argument of each line
manifest_values() {
  awk -v k="$2" '$1 == k { print $2 }' "$1/.shadow"
}

# per_branch_paths <shadow-dir>: print "<path> <numbered|->" per per-branch line
per_branch_paths() {
  awk '$1 == "per-branch" { d = $2; sub("/$", "", d); print d, ($3 == "numbered" ? "numbered" : "-") }' "$1/.shadow"
}

# numbered_dir <shadow-dir> <path>: if promoting a proposal at <path> gives it the
# next NNNN- prefix, print the numbered per-branch path it sits directly in
numbered_dir() {
  local dir numbered base
  while read -r dir numbered; do
    [ "$numbered" = numbered ] || continue
    case $2 in "$dir"/*) ;; *) continue ;; esac
    base=${2#"$dir"/}
    if [[ $base != */* ]] && ! [[ $base =~ ^[0-9]{4}- ]]; then echo "$dir"; return 0; fi
  done < <(per_branch_paths "$1")
  return 1
}

# has_per_branch <shadow-dir>: does the manifest declare any per-branch paths?
has_per_branch() { [ -n "$(per_branch_paths "$1")" ]; }

# find_shadow <key>: print the shadow dir whose manifest matches, if any
find_shadow() {
  local m
  for m in "$SHADOW_HOME"/*/.shadow; do
    [ -f "$m" ] || continue
    if [ "$(manifest_values "$(dirname "$m")" match)" = "$1" ]; then
      dirname "$m"
      return 0
    fi
  done
  return 1
}

is_declined() {
  [ -f "$DECLINED" ] && grep -qxF "$1" "$DECLINED"
}

# trunk_branch <shadow-dir>: the manifest's trunk (the last trunk line wins), or nothing
trunk_branch() { manifest_values "$1" trunk | tail -n 1; }

# shellcheck disable=SC2016  # the backticks are literal text
NO_TRUNK_WARNING='no trunk set, so branch areas are off until you add a `trunk <branch>` line to the manifest'

# The ~ goes through a variable: bash 5 would tilde-expand it to $HOME in place.
branch_slug() { local tilde='~'; printf '%s\n' "${1//\//$tilde}"; }

# branch_area <shadow-dir> <branch>: the branch's branch area (which may not exist yet)
branch_area() { printf '%s/branches/%s\n' "$1" "$(branch_slug "$2")"; }

# branch_areas <shadow-dir>: print every branch area that records its branch
branch_areas() {
  local area
  for area in "$1"/branches/*/; do
    area=${area%/}
    [ -f "$area/.branch" ] && echo "$area"
  done
  return 0
}

branch_exists() { git show-ref --verify --quiet "refs/heads/$1"; }

# detect_trunk: print the current repo's trunk, if one can be found: origin/HEAD,
# then init.defaultBranch, then main, then master. Apart from origin/HEAD's, the
# branch must exist locally to count.
detect_trunk() {
  local t
  if t=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null); then
    printf '%s\n' "${t#origin/}"
    return 0
  fi
  for t in "$(git config --get init.defaultBranch || true)" main master; do
    if [ -n "$t" ] && branch_exists "$t"; then printf '%s\n' "$t"; return 0; fi
  done
  return 0
}

# is_our_link <path> <target>: is <path> a symlink pointing exactly at <target>?
is_our_link() { [ -L "$1" ] && [ "$(readlink "$1")" = "$2" ]; }

# branch_name <branch-area-dir>: the real branch name recorded in .branch
branch_name() { awk '$1 == "name" { print $2 }' "$1/.branch"; }

# proposals <branch-area-dir>: each proposal's path relative to the branch
# area, sorted. Everything but folders and the .branch marker counts.
proposals() { (cd "$1" && find . ! -type d ! -path ./.branch | sed 's#^\./##' | sort); }

# branch_file_count <branch-area-dir>: how many proposals the branch area holds
branch_file_count() { proposals "$1" | wc -l | tr -d ' '; }

# write_exclude <git-common-dir> <shadow-dir>: replace the managed block
write_exclude() {
  local exclude="$1/info/exclude" tmp p
  mkdir -p "$1/info"
  touch "$exclude"
  tmp=$(mktemp "$exclude.XXXXXX")
  awk -v b="$BEGIN_MARK" -v e="$END_MARK" '
    $0 == b { skip = 1; next }
    $0 == e { skip = 0; next }
    !skip
  ' "$exclude" > "$tmp"
  {
    echo "$BEGIN_MARK"
    manifest_values "$2" link | while read -r p; do echo "/${p%/}"; done
    has_per_branch "$2" && echo "/$BRANCH_LINK"
    echo "$END_MARK"
  } >> "$tmp"
  mv "$tmp" "$exclude"
}

# sync_branch_link <checkout-top> <shadow-dir>: point .branch-shadow at this branch's area
sync_branch_link() {
  local top=$1 shadow=$2 dst="$1/$BRANCH_LINK" trunk branch area p
  if [ -e "$dst" ] && [ ! -L "$dst" ]; then
    warn "skipped $BRANCH_LINK: a real file is in the way"
    return
  fi
  # Only ever replace a link we made.
  if [ -L "$dst" ]; then
    case $(readlink "$dst") in
      "$shadow/branches/"*) rm "$dst" ;;
      *) warn "skipped $BRANCH_LINK: already a symlink to $(readlink "$dst")"; return ;;
    esac
  fi
  has_per_branch "$shadow" || return 0
  trunk=$(trunk_branch "$shadow")
  if [ -z "$trunk" ]; then warn "$NO_TRUNK_WARNING"; return 0; fi
  branch=$(git -C "$top" symbolic-ref --quiet --short HEAD) || return 0
  [ "$branch" = "$trunk" ] && return 0
  area=$(branch_area "$shadow" "$branch")
  mkdir -p "$area"
  [ -f "$area/.branch" ] || printf 'name    %s\ncreated %s\n' "$branch" "$(date +%F)" > "$area/.branch"
  while read -r p _; do mkdir -p "$area/$p"; done < <(per_branch_paths "$shadow")
  ln -s "$area" "$dst"
}

# sync_checkout <checkout-top> <shadow-dir>
sync_checkout() {
  local top=$1 shadow=$2 common state p name src dst old
  common=$(git -C "$top" rev-parse --path-format=absolute --git-common-dir)
  state="$(git -C "$top" rev-parse --path-format=absolute --git-dir)/shadow-links"

  # Prune links this checkout made for paths no longer in the manifest.
  if [ -f "$state" ]; then
    while read -r old; do
      manifest_values "$shadow" link | sed 's#/$##' | grep -qxF "$old" && continue
      dst="$top/$old"
      if is_our_link "$dst" "$shadow/$old"; then
        rm "$dst"
        # Remove parent dirs the link left empty, so a manifest can switch
        # from linking files to linking their directory.
        dst=$(dirname "$dst")
        while [ "$dst" != "$top" ] && rmdir "$dst" 2>/dev/null; do
          dst=$(dirname "$dst")
        done
      fi
    done < "$state"
  fi

  : > "$state.new"
  while read -r p; do
    name=${p%/}
    src="$shadow/$name"
    dst="$top/$name"
    if [ -L "$dst" ]; then
      if is_our_link "$dst" "$src"; then
        echo "$name" >> "$state.new"
      else
        warn "skipped $name: already a symlink to $(readlink "$dst")"
      fi
      continue
    fi
    if [ -e "$dst" ]; then
      if git -C "$top" ls-files --error-unmatch -- "$name" >/dev/null 2>&1; then
        warn "skipped $name: tracked in this checkout"
        continue
      fi
      if [ -e "$src" ] || [ -L "$src" ]; then
        warn "skipped $name: untracked copy here and in the shadow repo; merge by hand"
        continue
      fi
      mkdir -p "$(dirname "$src")"
      mv "$dst" "$src"
      warn "adopted $name into $shadow"
    fi
    case $p in */) mkdir -p "$src" ;; esac
    mkdir -p "$(dirname "$dst")"
    ln -s "$src" "$dst"
    echo "$name" >> "$state.new"
  done < <(manifest_values "$shadow" link)
  mv "$state.new" "$state"

  sync_branch_link "$top" "$shadow"
  write_exclude "$common" "$shadow"
}

# gone_branch_areas <shadow-dir>: print branch areas whose branch no longer exists
gone_branch_areas() {
  local area
  while read -r area; do
    branch_exists "$(branch_name "$area")" || echo "$area"
  done < <(branch_areas "$1")
}

# prune_empty_gone_branch_areas <shadow-dir>: remove gone branch areas with no proposals.
# Best effort: a failed removal never stops the caller.
prune_empty_gone_branch_areas() {
  local area
  while read -r area; do
    if [ "$(branch_file_count "$area")" = 0 ]; then rm -rf "$area" || true; fi
  done < <(gone_branch_areas "$1")
}

# with_timeout <seconds> <command>...: run the command, and if it's still running
# after <seconds>, kill it and everything it started (exit status 124). It runs
# in its own process group, so a child left holding stdout can't outlive it.
with_timeout() {
  perl -e '
    my $secs = shift;
    my $pid = fork // die "fork: $!";
    if (!$pid) { setpgrp; exec { $ARGV[0] } @ARGV or exit 127 }
    $SIG{ALRM} = sub { kill "TERM", -$pid };
    alarm $secs;
    1 while waitpid($pid, 0) == -1 && $!{EINTR};
    exit($? & 127 ? 124 : $? >> 8);
  ' "$@"
}

# pr_states <trunk>: print "<branch>\t<merged|open|closed>" for each branch with a
# pull request into the trunk, from its most recent one (gh lists newest
# first). Fails if gh is missing, not logged in, too slow or errors. It waits
# SHADOW_GH_TIMEOUT whole seconds (default 5; 0 waits forever).
pr_states() {
  command -v gh >/dev/null 2>&1 || return 1
  local json
  json=$(GH_PROMPT_DISABLED=1 with_timeout "${SHADOW_GH_TIMEOUT:-5}" \
    gh pr list --state all --base "$1" --json headRefName,state,mergedAt --limit 200 2>/dev/null) || return 1
  perl -MJSON::PP -e '
    binmode STDOUT, ":utf8";  # decode_json gives characters; branch names are UTF-8 bytes
    my %seen;
    for my $pr (@{ decode_json(do { local $/; <STDIN> }) }) {
      next if $seen{ $pr->{headRefName} }++;
      print "$pr->{headRefName}\t", ($pr->{mergedAt} ? "merged" : lc $pr->{state}), "\n";
    }
  ' <<< "$json"
}

# answer_for <answers> <branch>: from tab-separated lines that start with a
# branch name, print the rest of the branch's line, if it has one
answer_for() { awk -F'\t' -v b="$2" '$1 == b { sub(/^[^\t]*\t/, ""); print; exit }' <<< "$1"; }

# branch_area_answers <shadow-dir>: print "<branch>\t<state>\t<source>" for each branch
# area with proposals whose branch has an answer: state merged, open or closed
# (into the trunk), source gh or ancestry. Asks gh once; if gh can't answer,
# checks merges against origin/<trunk> locally, without fetching.
branch_area_answers() {
  local trunk area name names=() prs state
  trunk=$(trunk_branch "$1")
  [ -n "$trunk" ] || return 0
  while read -r area; do
    name=$(branch_name "$area")
    [ "$name" != "$trunk" ] && [ "$(branch_file_count "$area")" != 0 ] && names+=("$name")
  done < <(branch_areas "$1")
  [ ${#names[@]} -gt 0 ] || return 0
  if prs=$(pr_states "$trunk"); then
    for name in "${names[@]}"; do
      state=$(answer_for "$prs" "$name")
      if [ -n "$state" ]; then printf '%s\t%s\tgh\n' "$name" "$state"; fi
    done
  else
    for name in "${names[@]}"; do
      if merged_locally "$trunk" "$name"; then printf '%s\tmerged\tancestry\n' "$name"; fi
    done
  fi
  return 0
}

# merged_locally <trunk> <branch>: is the branch's work in origin/<trunk>, either
# as its own commits (ancestry) or as equivalent ones (patch-id, as a rebase
# merge leaves)? A squash merge isn't found. A branch with no commits of its
# own since it was created is in the trunk too, but hasn't been merged, so
# ancestry only counts once the branch has moved from where its reflog started.
merged_locally() {
  local trunk="refs/remotes/origin/$1" ref="refs/heads/$2" start cherry
  git show-ref --verify --quiet "$trunk" && git show-ref --verify --quiet "$ref" || return 1
  if git merge-base --is-ancestor "$ref" "$trunk"; then
    start=$(git reflog show --format=%H "$ref" -- 2>/dev/null | tail -n 1)
    [ -n "$start" ] && [ "$start" != "$(git rev-parse "$ref")" ]
    return
  fi
  cherry=$(git cherry "$trunk" "$ref" 2>/dev/null) || return 1
  [ -n "$cherry" ] && ! grep -q '^+' <<< "$cherry"
}

# require_shadow: print the current repo's shadow dir, or die. Assign it on its own
# line (`shadow=$(require_shadow)`): `local shadow=$(...)` would hide the failure.
require_shadow() {
  git rev-parse --show-toplevel >/dev/null 2>&1 || die "not inside a git checkout"
  find_shadow "$(repo_key)" || die "no shadow repo for $(repo_key); run \`git shadow init\`"
}

# commit_paths <shadow-dir> <message> <path>...: commit changes under the given
# paths in the shadow repo and nothing else. Paths are literal, never globs.
# Paths that neither exist nor were ever committed are skipped, since git
# rejects a pathspec matching nothing.
commit_paths() {
  local shadow=$1 message=$2 p paths=()
  shift 2
  local -x GIT_LITERAL_PATHSPECS=1
  for p; do
    p=${p#"$shadow"/}
    if [ -e "$shadow/$p" ] || [ -n "$(git -C "$shadow" ls-files -- "$p")" ]; then paths+=("$p"); fi
  done
  [ ${#paths[@]} -gt 0 ] || return 0
  git -C "$shadow" add -A -- "${paths[@]}"
  git -C "$shadow" diff --cached --quiet -- "${paths[@]}" 2>/dev/null && return 0
  git -C "$shadow" commit -q -m "$message" -- "${paths[@]}"
}

# commit_session_end <shadow-dir>: commit everything, if autocommit is on. The
# message names no branch: other sessions' changes may be in the commit too.
commit_session_end() {
  [ "$(manifest_values "$1" autocommit)" = on ] || return 0
  [ -n "$(git -C "$1" status --porcelain)" ] || return 0
  git -C "$1" add -A
  git -C "$1" commit -q -m "chore: sync at session end"
}

cmd_init() {
  git rev-parse --show-toplevel >/dev/null 2>&1 || die "not inside a git checkout"
  local key name="" shadow trunk top p links=() usage="usage: git shadow init [name] [--link <path>]..."
  top=$(git rev-parse --show-toplevel)
  while [ $# -gt 0 ]; do
    case $1 in
      --link)
        [ -n "${2:-}" ] || die "$usage"
        # Paths are relative to the checkout's root. A directory gets the trailing / that marks it.
        p=${2#./}
        case ${p%/} in
          ""|.|..|/*|../*|*/../*|*/..|.git|.git/*) die "--link $2: give a path inside the checkout, outside .git" ;;
        esac
        if [ -d "$top/$p" ] && [ ! -L "$top/$p" ]; then p="${p%/}/"; fi
        links+=("$p"); shift 2 ;;
      -*) die "$usage" ;;
      *) [ -z "$name" ] || die "$usage"; name=$1; shift ;;
    esac
  done
  key=$(repo_key)
  if shadow=$(find_shadow "$key"); then die "$key already has a shadow repo: $shadow"; fi
  # Default to the remote's repo name, or, with no remote, the folder of the
  # checkout that holds the git directory, whichever checkout init runs in.
  if [ -z "$name" ]; then
    case $key in
      path:*/.git) name=$(basename "$(dirname "${key#path:}")") ;;
      path:*) name=$(basename "${key#path:}" .git) ;;
      *) name=$(basename "$key") ;;
    esac
  fi
  # Lookups only see folders directly in $SHADOW_HOME, and skip dot folders.
  case $name in
    .*|*/*) die "shadow repo name $name can't start with a dot or contain a /; pass a different name" ;;
  esac
  shadow="$SHADOW_HOME/$name"
  [ -e "$shadow" ] && die "$shadow already exists; pass a different name"
  trunk=$(detect_trunk)
  mkdir -p "$shadow"
  {
    echo "match   $key"
    if [ -n "$trunk" ]; then echo "trunk   $trunk"; fi
    for p in ${links[@]+"${links[@]}"}; do echo "link    $p"; done
    cat <<'EOF'
# link       <path>             symlinked into every checkout; trailing / for a directory
# per-branch <path> [numbered]  new files for <path> go in .branch-shadow/<path>, one area per branch
# trunk      <branch>           gets no branch area; with no trunk line, branch areas are off
# context    <file>             printed into agent context at session start
# autocommit on                 commit this repo when an agent session ends
EOF
  } > "$shadow/.shadow"
  [ -n "$trunk" ] || warn "couldn't find the trunk (no origin/HEAD, init.defaultBranch, main or master); $NO_TRUNK_WARNING"
  git -C "$shadow" init -q
  if [ -f "$DECLINED" ]; then
    grep -vxF "$key" "$DECLINED" > "$DECLINED.tmp" || true
    mv "$DECLINED.tmp" "$DECLINED"
  fi
  sync_checkout "$top" "$shadow"
  if [ ${#links[@]} -gt 0 ]; then
    echo "created $shadow and linked those paths here; run \`git shadow sync --all\` to link every other checkout"
  else
    echo "created $shadow; add link lines to $shadow/.shadow, then run \`git shadow sync --all\`"
  fi
}

cmd_sync() {
  local shadow
  shadow=$(require_shadow)
  if [ "${1:-}" = "--all" ]; then
    local wt
    git worktree list --porcelain | sed -n 's/^worktree //p' | while read -r wt; do
      [ -d "$wt" ] || continue
      sync_checkout "$wt" "$shadow" 2>&1 | sed "s#^#$wt: #" >&2
    done
  else
    sync_checkout "$(git rev-parse --show-toplevel)" "$shadow"
  fi
}

# print_link_states <checkout-top> <shadow-dir>: each link's state in the checkout.
# Under a dangling link, names each branch area with a proposal at its path.
print_link_states() {
  local p name state area
  while read -r p; do
    name=${p%/}
    if ! is_our_link "$1/$name" "$2/$name"; then
      if [ -e "$1/$name" ]; then state="conflict (real file)"; else state=missing; fi
    elif [ -e "$1/$name" ]; then
      state=linked
    else
      printf '  %-40s %s\n' "$name" "dangling (target missing)"
      while read -r area; do
        [ -f "$area/$name" ] || continue
        if numbered_dir "$2" "$name" >/dev/null; then
          printf '    branch area %s has a proposal at this path, but promoting that branch numbers it, so it lands elsewhere\n' "$(branch_name "$area")"
        else
          printf '    branch area %s has a proposal at this path; it reaches here when that branch is promoted\n' "$(branch_name "$area")"
        fi
      done < <(branch_areas "$2")
      continue
    fi
    printf '  %-40s %s\n' "$name" "$state"
  done < <(manifest_values "$2" link)
}

cmd_status() {
  local shadow top name state area branch answers answer
  shadow=$(require_shadow)
  top=$(git rev-parse --show-toplevel)
  echo "repo:   $(repo_key)"
  echo "shadow: $shadow"
  print_link_states "$top" "$shadow"
  has_per_branch "$shadow" || return 0
  if [ -L "$top/$BRANCH_LINK" ]; then
    printf '  %-40s -> %s\n' "$BRANCH_LINK" "$(readlink "$top/$BRANCH_LINK")"
  else
    printf '  %-40s %s\n' "$BRANCH_LINK" "not linked (detached HEAD?)"
  fi
  echo "per-branch areas:"
  branch=$(git symbolic-ref --quiet --short HEAD || true)
  answers=$(branch_area_answers "$shadow")
  while read -r area; do
    name=$(branch_name "$area")
    if [ "$name" = "$(trunk_branch "$shadow")" ]; then state=trunk
    elif [ "$name" = "$branch" ]; then state=current
    elif branch_exists "$name"; then state=exists
    else state=gone
    fi
    answer=$(answer_for "$answers" "$name")
    [ -z "$answer" ] || state="$state, ${answer%$'\t'*} (${answer#*$'\t'})"
    printf '  %-50s %-21s %s files\n' "$name" "$state" "$(branch_file_count "$area")"
  done < <(branch_areas "$shadow")
}

# promote_into_branch <shadow-dir> <branch> <new-branch>: promote a branch area
# into a renamed branch's. A destination with no proposals is replaced; one with
# proposals takes the source's in, unless a path appears in both.
promote_into_branch() {
  local shadow=$1 name=$2 into=$3 src dst
  src=$(branch_area "$shadow" "$name")
  dst=$(branch_area "$shadow" "$into")
  [ "$src" != "$dst" ] || die "$name and $into share a branch area"
  if [ -d "$dst" ] && [ "$(branch_file_count "$dst")" != 0 ]; then
    add_proposals "$src" "$dst" "$name" "$into"
  else
    replace_branch_area "$src" "$dst" "$into"
  fi
  commit_paths "$shadow" "chore: promote branch area $name into $into" "$src" "$dst"
  echo "promoted branch area $name into $into; run \`git shadow sync --all\` to repoint checkouts"
}

# add_proposals <src-area> <dst-area> <branch> <new-branch>: move every proposal
# into a branch area that already has some. Refuses before moving anything if a
# path is taken in the destination, or a folder on its way is a file there.
add_proposals() {
  local src=$1 dst=$2 name=$3 into=$4 rel p clashes=()
  while read -r rel; do
    p=$rel
    if [ -e "$dst/$p" ] || [ -L "$dst/$p" ]; then clashes+=("$rel"); continue; fi
    while [[ $p == */* ]]; do
      p=${p%/*}
      if [ -L "$dst/$p" ] || { [ -e "$dst/$p" ] && [ ! -d "$dst/$p" ]; }; then clashes+=("$rel"); break; fi
    done
  done < <(proposals "$src")
  [ ${#clashes[@]} = 0 ] || die "$name and $into both have ${clashes[*]}; resolve by hand"
  while read -r rel; do
    mkdir -p "$(dirname "$dst/$rel")"
    mv "$src/$rel" "$dst/$rel"
  done < <(proposals "$src")
  rm -rf "$src"
}

# replace_branch_area <src-area> <dst-area> <new-branch>: move the source into
# the destination's place, recording the new branch name.
replace_branch_area() {
  local src=$1 dst=$2 into=$3 record
  # Write the new .branch record before anything moves, so a failure leaves
  # the source as it was. A fresh file, not an in-place edit: sed -i isn't portable.
  record=$(mktemp "$(dirname "$src")/.branch.XXXXXX")
  # shellcheck disable=SC2064  # expand now: the local is gone by the time EXIT fires
  trap "rm -f '$record'" EXIT
  { printf 'name    %s\n' "$into"; awk '$1 != "name"' "$src/.branch" 2>/dev/null || true; } > "$record"
  rm -rf "$dst"
  mv "$src" "$dst"
  mv "$record" "$dst/.branch"
}

# rewrite_references <shadow-dir> <plan>: in every text file in the shadow repo
# outside its git directory, replace each renamed proposal's old file name with
# its new one, and print the files changed. A match must be the whole name: no
# file-name character just before it, and none just after (a dot only counts
# when more of a name follows, so a sentence can end on a name). A name two
# proposals share but get different new names for is left alone, with a warning.
rewrite_references() {
  find "$1" -path "$1/.git" -prune -o -type f -print0 | perl -e '
    my (%renamed_to, %shared);
    open my $plan, "<", $ARGV[0] or die "$ARGV[0]: $!";
    while (<$plan>) {
      chomp;
      my ($old, $target) = map { m{([^/]+)$} } split /\t/;
      $shared{$old} = 1 if exists $renamed_to{$old} && $renamed_to{$old} ne $target;
      $renamed_to{$old} = $target;
    }
    for my $old (sort keys %shared) {
      delete $renamed_to{$old};
      warn "git-shadow: left references to $old as they were: proposals with that name got different numbers\n";
    }
    delete $renamed_to{$_} for grep { $renamed_to{$_} eq $_ } keys %renamed_to;
    exit 0 unless %renamed_to;
    my $names = join "|", map { quotemeta } sort { length $b <=> length $a } keys %renamed_to;
    my $name_char = qr/[\w.+~\x80-\xff-]/;
    my $reference = qr/(?<!$name_char)($names)(?![\w+~\x80-\xff-]|\.\w)/;
    local $/ = "\0";
    while (my $file = <STDIN>) {
      chomp $file;
      next if -B $file;
      my ($in, $out);
      unless (open $in, "<", $file) { warn "git-shadow: could not check $file for references: $!\n"; next; }
      my $text = do { local $/; <$in> };
      close $in;
      (my $rewritten = $text) =~ s/$reference/$renamed_to{$1}/g;
      next if $rewritten eq $text;
      unless (open $out, ">", $file) { warn "git-shadow: could not rewrite references in $file: $!\n"; next; }
      print $out $rewritten;
      close $out;
      print "$file\n";
    }
  ' "$2"
}

# promote_to_accepted <shadow-dir> <branch>: move a branch area's proposals to their accepted paths
promote_to_accepted() {
  local shadow=$1 name=$2 src plan rel target dir n f touched pending
  src=$(branch_area "$shadow" "$name")
  touched=("$src")

  # Plan every move first (relative source -> relative target), so a clash
  # aborts before anything is touched.
  plan=$(mktemp)
  # shellcheck disable=SC2064  # expand now: the local is gone by the time EXIT fires
  trap "rm -f '$plan'" EXIT
  while read -r rel; do
    target=$rel
    if dir=$(numbered_dir "$shadow" "$rel"); then
      n=$( { ls "$shadow/$dir" 2>/dev/null; awk -F'\t' '{ print $2 }' "$plan" | sed -n "s#^$dir/##p"; } \
        | grep -oE '^[0-9]{4}' | sort -n | tail -1 || true)
      target="$dir/$(printf '%04d' $((10#${n:-0} + 1)))-${rel#"$dir"/}"
    fi
    [ -e "$shadow/$target" ] && die "promoting $rel would overwrite $target; resolve by hand"
    printf '%s\t%s\n' "$rel" "$target" >> "$plan"
  done < <(proposals "$src")

  pending=$(git -C "$shadow" status --porcelain -z --untracked-files=all | tr '\0' '\n' | cut -c4-)
  while IFS=$'\t' read -r rel target; do
    mkdir -p "$(dirname "$shadow/$target")"
    mv "$src/$rel" "$shadow/$target"
    touched+=("$shadow/$target")
  done < "$plan"

  # Renumbering renames files; fix references to them anywhere in the shadow
  # repo. A rewrite to a file that already had changes pending isn't committed,
  # so a half-done edit isn't swept into the promote commit.
  while read -r f; do
    if grep -qxF -- "${f#"$shadow"/}" <<< "$pending"; then
      warn "rewrote references in ${f#"$shadow"/} but left it uncommitted: it had other changes pending"
    else
      touched+=("$f")
    fi
  done < <(rewrite_references "$shadow" "$plan")

  rm -rf "$src"
  commit_paths "$shadow" "chore: promote branch area $name to accepted paths" "${touched[@]}"
  awk -F'\t' '{ print "promoted " $1 " -> " $2 }' "$plan"
}

cmd_promote() {
  local shadow name=${1:-} into=""
  shadow=$(require_shadow)
  [ -n "$name" ] || die "usage: git shadow promote <branch> [--into <branch>]"
  if [ "${2:-}" = --into ]; then
    into=${3:-}
    [ -n "$into" ] || die "usage: git shadow promote <branch> --into <branch>"
  fi
  [ -d "$(branch_area "$shadow" "$name")" ] || die "no per-branch files for $name"
  if [ -n "$into" ]; then
    promote_into_branch "$shadow" "$name" "$into"
  else
    promote_to_accepted "$shadow" "$name"
  fi
}

cmd_drop() {
  local shadow name=${1:-} src
  shadow=$(require_shadow)
  [ -n "$name" ] || die "usage: git shadow drop <branch>"
  src=$(branch_area "$shadow" "$name")
  [ -d "$src" ] || die "no per-branch files for $name"
  # Commit the branch area as it stands first, so its proposals really are in history.
  commit_paths "$shadow" "chore: snapshot branch area $name before drop" "$src"
  rm -rf "$src"
  commit_paths "$shadow" "chore: drop branch area $name" "$src"
  echo "dropped per-branch files from $name (recoverable from the shadow repo's git history)"
}

# What onboard lists as candidate files, tracked or not, at any depth: files by
# name, and folders by path. .claude/ is left out on purpose: teams often commit
# .claude/settings.json.
ONBOARD_FILES="AGENTS.md CLAUDE.md CLAUDE.local.md GEMINI.md CONTEXT.md CONTEXT-MAP.md GLOSSARY.md .cursorrules"
ONBOARD_DIRS="adr docs/agents .scratch .cursor/rules"

# candidate_paths <kind>: for each path on stdin that is or sits inside a
# candidate, print "<kind>\t<candidate>", a folder with its trailing /
candidate_paths() {
  awk -v kind="$1" -v files="$ONBOARD_FILES" -v dirs="$ONBOARD_DIRS" '
    BEGIN { n = split(files, f, " "); for (i = 1; i <= n; i++) isfile[f[i]] = 1; m = split(dirs, d, " ") }
    {
      p = $0; sub("/$", "", p)
      for (i = 1; i <= m; i++) {
        # Where d[i] starts in p, as a whole run of path components
        j = index("/" p "/", "/" d[i] "/")
        if (j) { printf "%s\t%s/\n", kind, substr(p, 1, j - 1 + length(d[i])); next }
      }
      b = p; sub(".*/", "", b)
      if (b in isfile) printf "%s\t%s\n", kind, p
    }'
}

# not_our_links <checkout-top>: drop paths on stdin that are links into a shadow repo
not_our_links() {
  local p
  while IFS= read -r p; do
    if [ -L "$1/${p%/}" ]; then
      case $(readlink "$1/${p%/}") in "$SHADOW_HOME"/*) continue ;; esac
    fi
    printf '%s\n' "$p"
  done
}

# print_candidates <checkout-top>: each candidate file and whether it's tracked.
# Ignored folders are listed whole, so a node_modules/ costs one line.
print_candidates() {
  {
    git -C "$1" ls-files -z | tr '\0' '\n' | candidate_paths tracked
    git -C "$1" ls-files -z --others --exclude-standard | tr '\0' '\n' \
      | not_our_links "$1" | candidate_paths untracked
    git -C "$1" ls-files -z --others --ignored --exclude-standard --directory | tr '\0' '\n' \
      | not_our_links "$1" | candidate_paths "untracked, ignored"
  } | awk -F'\t' '
    !seen[$0]++ { kinds[$2] = ($2 in kinds) ? kinds[$2] ", " $1 : $1 }
    END { for (p in kinds) printf "  %-40s %s\n", p, kinds[p] }
  ' | sort
}

# hook_installed_in <checkout-top> <hook>: the first Claude Code settings file
# that runs `git-shadow <hook>`, if any
hook_installed_in() {
  local f
  for f in "$HOME/.claude/settings.json" "$1/.claude/settings.json" "$1/.claude/settings.local.json"; do
    if [ -f "$f" ] && grep -qF "git-shadow $2" "$f"; then
      case $f in "$1"/*) echo "${f#"$1"/}" ;; *) echo "~${f#"$HOME"}" ;; esac
      return 0
    fi
  done
  return 1
}

# onboard_prompt: where the onboarding prompt is, next to the real git-shadow
# (resolving the symlink it's usually installed through)
onboard_prompt() {
  local real
  real=$(perl -MCwd=abs_path -e 'print abs_path(shift)' "$0")
  printf '%s/prompts/onboard.md\n' "$(dirname "$(dirname "$real")")"
}

cmd_onboard() {
  git rev-parse --show-toplevel >/dev/null 2>&1 || die "not inside a git checkout"
  local key top shadow trunk prompt hook where candidates
  prompt=$(onboard_prompt)
  [ -f "$prompt" ] || die "can't find the onboarding prompt at $prompt; install git-shadow by symlinking bin/git-shadow from its repo"
  key=$(repo_key)
  top=$(git rev-parse --show-toplevel)
  echo "repo:     $key"
  if shadow=$(find_shadow "$key"); then
    echo "shadow:   $shadow"
    trunk=$(trunk_branch "$shadow")
    if [ -n "$trunk" ]; then echo "trunk:    $trunk (from the manifest)"; else echo "trunk:    none set in the manifest"; fi
  else
    if is_declined "$key"; then
      echo "declined: you ran \`git shadow decline\` for this repo. To onboard it anyway, delete"
      echo "          the line \`$key\` from $DECLINED and run this again."
      return 0
    fi
    echo "shadow:   none yet; \`git shadow init\` creates one"
    trunk=$(detect_trunk)
    if [ -n "$trunk" ]; then echo "trunk:    $trunk (detected; init will record it)"; else echo "trunk:    none found"; fi
  fi
  echo "Claude Code hooks:"
  for hook in hook-start hook-end; do
    if where=$(hook_installed_in "$top" "$hook"); then where="installed ($where)"; else where="not found"; fi
    printf '  %-10s  %s\n' "$hook" "$where"
  done
  if [ -n "$shadow" ]; then
    echo "manifest ($shadow/.shadow):"
    grep -v '^[[:space:]]*#' "$shadow/.shadow" | grep -v '^[[:space:]]*$' | sed 's/^/  /' || true
    echo "links in this checkout:"
    print_link_states "$top" "$shadow"
  fi
  echo "candidate files:"
  candidates=$(print_candidates "$top")
  printf '%s\n' "${candidates:-  none found}"
  echo
  echo "---"
  # Skip the prompt file's leading comment, which is for whoever edits it.
  awk 'NR == 1 && /^<!--/ { c = 1 } c { if (/-->/) c = 0; next } 1' "$prompt"
}

cmd_decline() {
  git rev-parse --show-toplevel >/dev/null 2>&1 || die "not inside a git checkout"
  mkdir -p "$SHADOW_HOME"
  repo_key >> "$DECLINED"
  echo "won't offer a shadow repo for $(repo_key) again"
}

# drain_hook_payload: read and discard the hook's stdin, but never wait on a terminal
drain_hook_payload() { [ -t 0 ] || cat > /dev/null || true; }

cmd_hook_start() {
  drain_hook_payload
  git rev-parse --show-toplevel >/dev/null 2>&1 || exit 0
  local key shadow f out top trunk branch p numbered gone area bin
  bin=$(command -v git-shadow 2>/dev/null || echo "$0")
  key=$(repo_key)
  if ! shadow=$(find_shadow "$key"); then
    is_declined "$key" && exit 0
    cat <<EOF
git-shadow: this repo ($key) has no shadow repo for personal, untracked files.
At a natural pause, ask the user once whether to set one up or never be asked again for this
repo (\`$bin decline\`). If they want one, run \`$bin onboard\` and follow what it prints.
Don't run either without their answer.
EOF
    exit 0
  fi

  top=$(git rev-parse --show-toplevel)
  out=$(sync_checkout "$top" "$shadow" 2>&1) || true
  [ -n "$out" ] && printf '%s\n\n' "$out"

  while read -r f; do
    [ -f "$shadow/$f" ] || continue
    printf '<!-- %s, from shadow repo %s -->\n' "$f" "$shadow"
    cat "$shadow/$f"
    echo
  done < <(manifest_values "$shadow" context)

  if has_per_branch "$shadow"; then
    trunk=$(trunk_branch "$shadow")
    branch=$(git symbolic-ref --quiet --short HEAD || true)
    if [ -z "$trunk" ]; then
      :  # sync's warning, printed above, says branch areas are off
    elif [ -n "$branch" ] && [ "$branch" = "$trunk" ]; then
      echo "git-shadow: this checkout is on the trunk branch ($branch), so new files go straight in the accepted paths."
    elif [ -n "$branch" ]; then
      echo "git-shadow: this checkout is on branch $branch. Existing files stay where they are and are"
      echo "edited in place, but put NEW files for these paths in this branch's area instead:"
      while read -r p numbered; do
        printf '  %s/ -> %s/%s/' "$p" "$BRANCH_LINK" "$p"
        [ "$numbered" = numbered ] && printf '  (no NNNN- prefix; numbers are assigned on promote)'
        echo
      done < <(per_branch_paths "$shadow")
      echo "Read both locations: $BRANCH_LINK/ holds this branch's proposals, the plain paths hold accepted files."
    else
      echo "git-shadow: this checkout has no branch (detached HEAD), so it has no per-branch area."
      echo "Before creating a new file under $(per_branch_paths "$shadow" | awk '{ printf "%s%s/", sep, $1; sep = ", " }'), ask the user where it should go."
    fi
    echo

    prune_empty_gone_branch_areas "$shadow"
    report_branch_areas "$shadow" "$bin"
  fi
  exit 0
}

# list_branch_areas <shadow-dir> <branch>...: each branch and its proposal count, for hook-start
list_branch_areas() {
  local shadow=$1 name
  shift
  for name; do echo "  $name ($(branch_file_count "$(branch_area "$shadow" "$name")") files)"; done
}

# report_branch_areas <shadow-dir> <command-path>: tell the agent which branch
# areas need the user's decision: merged ones (promote), gone ones whose pull
# request was closed (drop), and gone ones with no answer either way. A gone
# branch with an open pull request isn't mentioned.
report_branch_areas() {
  local shadow=$1 bin=$2 answers area name state merged=() closed=() gone=()
  answers=$(branch_area_answers "$shadow")
  while IFS=$'\t' read -r name state _; do
    [ "$state" = merged ] && merged+=("$name")
  done <<< "$answers"
  while read -r area; do
    name=$(branch_name "$area")
    state=$(answer_for "$answers" "$name")
    case ${state%%$'\t'*} in
      "") gone+=("$name") ;;
      closed) closed+=("$name") ;;
    esac
  done < <(gone_branch_areas "$shadow")
  if [ ${#merged[@]} -gt 0 ]; then
    echo "git-shadow: these branches are merged into the trunk ($(trunk_branch "$shadow")), but still have proposals:"
    list_branch_areas "$shadow" "${merged[@]}"
    echo "At a natural pause, recommend promoting them into the accepted files (\`$bin promote <branch>\`)"
    echo "and ask the user. Don't run it without their answer."
  fi
  if [ ${#closed[@]} -gt 0 ]; then
    echo "git-shadow: these branches no longer exist and their pull requests were closed without merging,"
    echo "but they still have proposals:"
    list_branch_areas "$shadow" "${closed[@]}"
    echo "At a natural pause, recommend dropping them (\`$bin drop <branch>\`) and ask the user."
    echo "Don't run it without their answer."
  fi
  if [ ${#gone[@]} -gt 0 ]; then
    echo "git-shadow: these branches no longer exist, but still have proposals:"
    list_branch_areas "$shadow" "${gone[@]}"
    echo "At a natural pause, ask the user what to do with each: promote into the accepted files"
    echo "(\`$bin promote <branch>\`), move to a renamed branch (\`$bin promote <branch> --into <new>\`),"
    echo "or drop (\`$bin drop <branch>\`). Don't run any of these without their answer."
  fi
}

cmd_hook_end() {
  drain_hook_payload
  git rev-parse --show-toplevel >/dev/null 2>&1 || exit 0
  local shadow
  shadow=$(find_shadow "$(repo_key)") || exit 0
  commit_session_end "$shadow" || true
  exit 0
}

case "${1:-}" in
  init) shift; cmd_init "$@" ;;
  sync) shift; cmd_sync "$@" ;;
  status) cmd_status ;;
  onboard) cmd_onboard ;;
  promote) shift; cmd_promote "$@" ;;
  drop) shift; cmd_drop "$@" ;;
  decline) cmd_decline ;;
  hook-start) cmd_hook_start ;;
  hook-end) cmd_hook_end 2>/dev/null ;;
  -h|--help|help|"") usage ;;
  *) usage >&2; exit 2 ;;
esac
